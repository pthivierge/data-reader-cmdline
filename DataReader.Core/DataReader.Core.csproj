<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>DataReader.Core</RootNamespace>
    <AssemblyName>DataReader.Core</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Keep the hand-written Properties\AssemblyInfo.cs instead of an SDK-generated one -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Output to bin\Debug\ (no net8.0 sub-folder) to match the original layout -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aveva.AFSDK" Version="3.2.0.52" />
    <PackageReference Include="NLog" Version="6.1.3" />
  </ItemGroup>

</Project>
