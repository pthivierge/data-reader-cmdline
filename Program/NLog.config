<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <!-- Layout ported from the former log4net pattern:
       *%-10level %-30date %message [%logger] [%thread]
       The exception (when one is attached) is appended on its own line. -->
  <variable name="lineLayout"
            value="*${level:uppercase=true:padding=-10} ${longdate:padding=-30} ${message} [${logger}] [${threadid}] ${onexception:inner=${newline}${exception:format=tostring}}" />

  <targets>
    <!-- Rolling file: 20 MB per file, 10 archives, also rolls daily (composite) -->
    <target name="file" xsi:type="File"
            fileName="${basedir}/Logs/CommandLine.Log"
            archiveFileName="${basedir}/Logs/CommandLine.{#}.Log"
            archiveAboveSize="20971520"
            archiveEvery="Day"
            maxArchiveFiles="10"
            archiveDateFormat="yyyyMMdd"
            keepFileOpen="true"
            encoding="utf-8"
            layout="${lineLayout}" />

    <!-- Colored console: Error=red, Warn=yellow, everything else=green -->
    <target name="console" xsi:type="ColoredConsole"
            useDefaultRowHighlightingRules="false"
            layout="${lineLayout}">
      <highlight-row condition="level == LogLevel.Error or level == LogLevel.Fatal" foregroundColor="Red" />
      <highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow" />
      <highlight-row condition="level &lt;= LogLevel.Info" foregroundColor="Green" />
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Trace" writeTo="file,console" />
  </rules>

</nlog>
